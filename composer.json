{
  "name": "publishpress/publishpress-planner",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "description": "WordPress plugin to accelerate your publishing workflow.",
  "homepage": "http://publishpress.com/",
  "authors": [
    {
      "name": "PublishPress",
      "email": "help@publishpress.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "mustache/mustache": "2.14.1",
    "publishpress/dev-workspace": "^2.0.3"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "publishpress/dev-workspace": true
    },
    "process-timeout": 7200
  },
  "scripts": {
    "info:version": "@info:versions",
    "build:dir": "@pack:dir",
    "build:clean": "@pack:clean",
    "check:phpcs": "@lint:phpcs",
    "pre-autoload-dump": "@composer dumpautoload --working-dir=./lib",
    "pre-update-cmd": "@composer update --working-dir=./lib",
    "pre-install-cmd": "@composer install --working-dir=./lib",
    "term": "bash ./vendor/publishpress/dev-workspace/scripts/run.sh"
  },
  "extra": {
    "plugin-name": "publishpress-planner",
    "plugin-slug": "publishpress",
    "plugin-folder": "publishpress",
    "version-constant": "PUBLISHPRESS_VERSION",
    "plugin-lang-domain": "publishpress",
    "plugin-github-repo": "publishpress/publishpress-planner",
    "plugin-composer-package": "publishpress/publishpress-planner"
  }
}
