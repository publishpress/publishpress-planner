<?xml version="1.0"?>
<ruleset name="PublishPressPluginReview">
    <description>WordPress.org plugin review for production plugin code.</description>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="./"/>
    <arg name="parallel" value="20"/>
    <!-- Keep advisory warnings visible while CI fails on errors. -->
    <config name="ignore_warnings_on_exit" value="1"/>
    <file>.</file>
    <exclude-pattern>/.cache/*</exclude-pattern>
    <exclude-pattern>*/\.github/*</exclude-pattern>
    <exclude-pattern>/\.vscode/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>/bin/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/dev-workspace-cache/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/RoboFile.php</exclude-pattern>
    <exclude-pattern>/\.web/</exclude-pattern>
    <exclude-pattern>/\.ddev/</exclude-pattern>
    <rule ref="vendor/publishpress/publishpress-phpcs-standards/standards/plugin-check-rulesets/plugin-review.xml"/>
</ruleset>
