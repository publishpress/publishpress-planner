#
# Plugin identity (keep keys aligned with composer.json extra)
#
PLUGIN_NAME="PublishPress Planner"
PLUGIN_TYPE="FREE"
PLUGIN_COMPOSER_PACKAGE="publishpress/publishpress-planner"
PLUGIN_SLUG="publishpress"

#
# Git / GitHub (optional; set token for releases/API; leave name/email empty to be prompted)
#
GITHUB_ACCESS_TOKEN="ghp_0000000000000000000000000000000000000000"
GIT_USER_NAME=""
GIT_USER_EMAIL=""
# Docker for Mac can report "/root/.gitconfig: Resource busy" when the shared
# workspace tries to update the bind-mounted global config. Point Git at a
# writable cache file inside the project instead.
GIT_CONFIG_GLOBAL="/project/dev-workspace-cache/.gitconfig-global"

#
# Docker (shared image tags — keep these aligned across PublishPress plugins)
#
CONTAINER_NAME="planner_free"
TERMINAL_IMAGE_NAME="publishpress/dev-workspace-terminal:node-25"
WP_IMAGE_NAME="publishpress/dev-workspace-wordpress:wordpress-6.9-php-8.5"
WPCLI_IMAGE_NAME="publishpress/dev-workspace-wpcli:wpcli-2-php-8.5"

#
# Local cache (relative to plugin root unless absolute)
#
CACHE_PATH="./dev-workspace-cache"

#
# WordPress / Codeception test paths
#
WP_TESTS_ROOT_DIR="dev-workspace-cache/wp_test"
WP_TESTS_DB_URL="mysql://root:root@127.0.0.1:3342/wordpress"
WP_TESTS_TEST_TABLE_PREFIX="wp_"
WP_TESTS_TABLE_PREFIX="wp_"

#
# Published ports (change if they conflict with other containers)
#
WP_TESTS_HTTP_PORT="8051"
DB_TESTS_PORT="3342"
MAILHOG_WEB_PORT="8053"
MAILHOG_SMTP_PORT="8054"

#
# End-to-end tests (WordPress site under test)
#
WP_TESTS_URL="http://localhost:8051"
WP_TESTS_DOMAIN="localhost:8051"
WP_TESTS_ADMIN_PATH="/wp-admin"
WP_TESTS_ADMIN_USER="admin"
WP_TESTS_ADMIN_PASSWORD="admin"

#
# ChromeDriver (composer scripts may source .env for CHROMEDRIVER_*)
#
CHROMEDRIVER_HOST="localhost"
CHROMEDRIVER_PORT="9515"
CHROMEDRIVER_BINARY="/opt/homebrew/bin/chromedriver"

#
# Translations
#
LANG_LOCALES="de_DE es_ES fi fil fr_FR id_ID it_IT ja ko_KR nl_NL pt_BR ru_RU yo"
LANG_DOMAIN="publishpress"
LANG_DIR="languages"
GENERATE_TRANSLATION_JSON="1"

#
# Sync (optional; placeholders only)
#
LOCAL_SYNC_TARGET_DIR="/path/to/wp-content/plugins/publishpress"
REMOTE_SYNC_SOURCE_DIR="/path/to/publishpress-planner/checkout"
REMOTE_SYNC_REMOTE_HOST="example-host"
REMOTE_SYNC_REMOTE_PORT="22"
REMOTE_SYNC_REMOTE_TARGET_DIR="/path/to/remote/wp-content/plugins/publishpress"
SSH_KEY_PATH="/path/to/your/private_key"

#
# Translation services (optional)
#
OPENAI_API_KEY="sk-proj-your-openai-key"
WEBLATE_API_TOKEN="wlu_your-weblate-token"
WEBLATE_API_URL="https://weblate.publishpress.com/api"
